{
  "name": "devkit",
  "productName": "工坊(DevKit)",
  "version": "1.2.0",
  "description": "专业开发者的一站式效率工具箱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-mac": "electron-builder --mac && node scripts/cleanup.js",
    "build-win": "electron-builder --win && node scripts/cleanup.js",
    "build-linux": "electron-builder --linux && node scripts/cleanup.js"
  },
  "keywords": [
    "developer",
    "tools",
    "json",
    "excel",
    "timestamp"
  ],
  "author": "phpxcn <https://gitee.com/phpxcn>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.3",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "papaparse": "^5.5.3",
    "pngjs": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.phpxcn.devkit",
    "productName": "工坊(DevKit)",
    "copyright": "Copyright © 2026 phpxcn",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "assets/icons/icon.png",
      "uninstallerIcon": "assets/icons/icon.png",
      "shortcutName": "工坊(DevKit)"
    }
  }
}
